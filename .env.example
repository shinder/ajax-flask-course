# 複製成 .env 後填入值。.env 已在 .gitignore，不會進版控。
#
# JWT 簽章金鑰：至少 32 個字元的隨機字串。產生方式擇一：
#   macOS / Linux：  openssl rand -base64 48
#   任何環境：       uv run python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_KEY=for_demo_pEUp4R35qi9aRGyBe4QZrEVqIs6

# Flask session 的簽章金鑰（第 10 章 Session 登入用）。同樣至少 32 個字元，
# 用上面的指令再產生一組，不要和 JWT_KEY 用同一個值
SECRET_KEY=for_demo_gryyiFHCvCARURN4WL1KmlYHzoUZ6rVtJo_ruM

# token 有效分鐘數（選填，預設 60）。想看 token 過期的效果可以改成 1
# JWT_EXPIRE_MINUTES=60
